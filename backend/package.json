{
  "name": "real-time-conversation-translator-backend",
  "version": "1.0.0",
  "description": "Backend for Real-Time Conversation Translator",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.js\"",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js"
  },
  "keywords": [
    "translation",
    "real-time",
    "conversation",
    "multilingual"
  ],
  "author": "satokaze12",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.5.4",
    "pg": "^8.8.0",
    "redis": "^4.6.7",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "joi": "^17.9.1",
    "axios": "^1.4.0",
    "google-cloud-translate": "^7.1.0",
    "google-cloud-speech": "^5.0.0",
    "google-cloud-text-to-speech": "^5.1.0",
    "azure-cognitiveservices-language-translator": "^3.1.0",
    "deepl-node": "^1.5.0",
    "uuid": "^9.0.0",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.7.0",
    "winston": "^3.8.2",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "jest": "^29.5.0",
    "@types/jest": "^29.5.2",
    "supertest": "^6.3.3",
    "eslint": "^8.43.0",
    "prettier": "^2.8.8",
    "db-migrate": "^0.11.13",
    "db-migrate-pg": "^1.2.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
